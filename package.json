{
  "name": "electrical-studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Vẽ và mô phỏng trạng thái mạch điện",
  "author": "Electrical Studio",
  "repository": { "type": "git", "url": "https://github.com/Nguyendal21/electrical-studio.git" },
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test src/model/*.test.ts",
    "test:e2e": "playwright test",
    "desktop": "npm run build && electron .",
    "package:win": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-desktop-icon.ps1 && electron-builder --win nsis --x64 --publish never",
    "package:portable": "npm run build && electron-builder --win portable --x64 --publish never",
    "test:updater": "node --test desktop/updater.test.cjs",
    "test:desktop": "node scripts/smoke-desktop.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.0.0",
    "electron-updater": "6.8.11",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
